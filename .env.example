# Supabase (required for auth and data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: for server-side admin operations that bypass RLS (e.g. assigning roles)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth app (register once at console.cloud.google.com — shared across all clients)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public app URL (OAuth redirects, server fetches). Prefer full URL with https://
# (e.g. https://cms.witflow.co). Host-only values get https:// prepended automatically.
# No trailing slash.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# AI provider (default: gemini). Set AI_PROVIDER=openai for the OpenAI stack.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# Text (default: gemini-3.1-flash-lite)
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# Instruction ranking (default: gemini-embedding-2)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Cover images — Nano Banana 2 (default: gemini-3.1-flash-image)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Reference banner vision (default: gemini-3.1-flash-lite)
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# OpenAI (optional fallback when AI_PROVIDER=gemini; required when AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
# OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_VISION_MODEL=gpt-4.1-mini
# OPENAI_RESPONSES_IMAGE_MODEL=gpt-5.5
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Scheduler: Bearer for POST /api/scheduler (admin "Run scheduler", Inngest, external cron).
# Traffic trigger (/api/scheduler/trigger) also works without this if SUPABASE_SERVICE_ROLE_KEY is set.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret

# DG ↔ AI CMS (see docs/DG_INTEGRATION.md and docs/00_shared_integration_contract_dg_ai_cms.md)
# Incoming: DG -> CMS article briefs (Bearer on POST /api/integrations/dg/article-briefs)
DG_INTEGRATION_BEARER_SECRET=
# Outgoing: CMS -> DG status webhooks (POST to DG /api/integrations/ai-cms/article-status)
DG_STATUS_WEBHOOK_URL=
DG_STATUS_WEBHOOK_BEARER_SECRET=
