# Framer Server API (Site Settings → General → API key)
FRAMER_API_KEY=
# Project URL from the browser, e.g. https://framer.com/projects/MySite--xxxxxxxx
FRAMER_PROJECT_URL=

# Exact name of the Managed Collection already created in Framer
FRAMER_COLLECTION_NAME=Posts

# Same secret configured in Witflow CMS Admin → Webhook secret
WEBHOOK_SECRET=

# Base locale for item `value` fields (pt | en | fr)
DEFAULT_LOCALE=en

# Optional CMS→Framer locale id overrides (auto-match via getLocales when omitted)
# Example: pt:localeId1,en:localeId2,fr:localeId3
FRAMER_LOCALE_MAP=

# After upsert/delete: publish preview, then promote to production when true
FRAMER_AUTO_DEPLOY=true

# HTTP
PORT=8787
HOST=0.0.0.0
